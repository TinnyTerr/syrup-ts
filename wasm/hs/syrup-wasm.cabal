cabal-version:      3.0
name:               syrup-wasm
version:            0.1.0.0
build-type:         Simple

executable syrup-wasm
    main-is:          SyrupWasm.hs
    build-depends:    base, ghc-experimental, syrup
    default-language: Haskell2010
    ghc-options:      -O1 -no-hs-main -optl-mexec-model=reactor
                      "-optl-Wl,--export=hs_init,--export=syrup"
