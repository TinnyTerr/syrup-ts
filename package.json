{
	"name": "syrup-ts",
	"version": "0.1.0",
	"type": "module",
	"private": false,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "GPL-3.0-only",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./tiny": {
			"types": "./dist/tiny/index.d.ts",
			"default": "./dist/tiny.js"
		}
	},
	"files": [
		"dist",
		"LICENCE",
		"README.md"
	],
	"bin": {
		"syrup": "./dist/cli.js"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"build:lib": "bun scripts/build.ts --lib",
		"build:cli": "bun scripts/build.ts --cli",
		"build:web": "bun scripts/build.ts --web",
		"build:obsidian": "bun scripts/build.ts --obsidian",
		"build:vscode": "bun scripts/build.ts --vscode",
		"build:all": "bun scripts/build.ts --all",
		"build:exe": "bun build ./index.ts --compile --minify --outfile dist/exe/syrup",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@types/bun": "latest",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7"
	},
	"dependencies": {
		"mermaid": "^12.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
}
